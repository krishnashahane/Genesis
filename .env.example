# Local development defaults
GENESIS_ENV=development
GENESIS_API_HOST=127.0.0.1
GENESIS_API_PORT=8000
GENESIS_API_KEY=

# Optional browser/API access control
GENESIS_CORS_ORIGINS=
GENESIS_MAX_REQUEST_BYTES=1000000

# LLM
GENESIS_LLM_PROVIDER=mock
GENESIS_LLM_MODEL=claude-opus-4-8
GENESIS_ANTHROPIC_API_KEY=
GENESIS_GEMINI_API_KEY=

# Optional backends
GENESIS_REDIS_URL=
GENESIS_POSTGRES_DSN=
GENESIS_CHROMA_PATH=./.genesis/chroma
